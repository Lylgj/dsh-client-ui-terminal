{
	"name": "@deepseek-ai/dsh-client-ui-terminal",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "DSH Web 终端插件：默认接入 DSH 官方右侧栏（终端页签 + 开始页入口），也可作为 dsh-better-sidebar 页签或独立浮层面板运行；宿主半边提供同源 PTY WebSocket，支持 cmd / PowerShell / WSL / SSH。",
	"license": "MIT",
	"main": "lib/index.js",
	"icon": "./icon.svg",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lylgj/dsh-client-ui-terminal.git"
	},
	"homepage": "https://github.com/Lylgj/dsh-client-ui-terminal",
	"bugs": {
		"url": "https://github.com/Lylgj/dsh-client-ui-terminal/issues"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"cordis",
		"cordis-plugin",
		"terminal",
		"xterm",
		"node-pty",
		"web-terminal",
		"sidebar-right",
		"better-sidebar"
	],
	"engines": {
		"node": ">=20",
		"dsh": ">=0.2.2-rc.1"
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-client-runtime": "^0.2.2-rc.1",
		"@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.1"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-client-runtime": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-layout": {
			"optional": true
		}
	},
	"files": [
		"lib",
		"assets",
		"cordis.patch.yml",
		"examples",
		"icon.svg",
		"README.md",
		"LICENSE",
		"THIRD-PARTY-NOTICES.md"
	],
	"scripts": {
		"test": "node tests/terminal-behavior.mjs && node tests/better-sidebar-integration.mjs && node tests/official-sidebar-integration.mjs",
		"test:behavior": "node tests/terminal-behavior.mjs",
		"test:sidebar": "node tests/better-sidebar-integration.mjs",
		"test:official": "node tests/official-sidebar-integration.mjs",
		"test:pty": "node tests/terminal-pty.mjs",
		"test:pager": "node tests/terminal-pager.mjs"
	},
	"dsh": {
		"manifestVersion": 1,
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-layout"
			]
		}
	},
	"dependencies": {
		"node-pty": "^1.0.0",
		"ws": "^8.0.0"
	}
}
