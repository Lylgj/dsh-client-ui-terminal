{
	"name": "@deepseek-ai/dsh-client-ui-terminal",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "DSH Web 终端插件：装了 dsh-better-sidebar 时接入其侧栏（终端的侧栏页签），没装时以右侧常驻面板独立运行；宿主半边提供同源 PTY WebSocket。",
	"license": "MIT",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lylgj/dsh-client-ui-terminal.git"
	},
	"homepage": "https://github.com/Lylgj/dsh-client-ui-terminal",
	"bugs": {
		"url": "https://github.com/Lylgj/dsh-client-ui-terminal/issues"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"cordis",
		"cordis-plugin",
		"terminal",
		"xterm",
		"node-pty",
		"web-terminal",
		"better-sidebar"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "node tests/terminal-behavior.mjs && node tests/better-sidebar-integration.mjs",
		"test:behavior": "node tests/terminal-behavior.mjs",
		"test:sidebar": "node tests/better-sidebar-integration.mjs",
		"test:pty": "node tests/terminal-pty.mjs",
		"test:pager": "node tests/terminal-pager.mjs"
	},
	"dsh": {
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-layout"
			]
		}
	},
	"dependencies": {
		"node-pty": "^1.0.0",
		"ws": "^8.0.0"
	}
}
